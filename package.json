{
  "name": "poe-stash-pricer",
  "version": "0.1.0",
  "description": "Local web app (Windows/Linux/macOS) that watches a Path of Exile 1 public stash tab and prices new items using poe.ninja and the official trade site.",
  "license": "MIT",
  "private": true,
  "main": "build/server/server.js",
  "scripts": {
    "preinstall": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "start": "npm run build && node build/server/server.js",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
